# Server Configuration
PORT=5000
NODE_ENV=development
SUPERVISOR_SECRET_KEY=supervisor-secret-key-12345
DATABASE_FILE=./data/internships.db
TIMEZONE=Asia/Kolkata

# Gemini AI (Optional for live AI - mock fallback provided when unset)
GEMINI_API_KEY=

# GitHub REST API (Optional for higher rate limits or private repos)
GITHUB_TOKEN=

# Email / SMTP (Optional - interactive email preview dialog provided when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Internship Program <internships@example.com>"

# Google Calendar (Optional - manual Google Meet link entry always supported)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Scheduler
REVIEW_INTERVAL_DAYS=2
